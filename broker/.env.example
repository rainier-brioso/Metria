# Documentation template only; not automatically loaded. Never fill in or commit a real key here.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Choose an actual NVIDIA model available in the configured account and region.
NEBIUS_MODEL=
# Variables alone never enable live mode. Local serve requires --live --account-verified.
# Hosted container config (set only on the hosting service, not in a committed .env):
METRIA_PUBLIC_HOST=
METRIA_STATE_DIR=/state
METRIA_PERSISTENT_STATE_CONFIRMED=no
METRIA_LIVE=0
METRIA_ACCOUNT_VERIFIED=no
# Explicitly permit member-initiated photos/text with authenticated private passes.
# Requires live mode; keep no for synthetic-only rehearsals.
METRIA_ALLOW_CLOUD_ASSISTANT=no
PORT=8765
